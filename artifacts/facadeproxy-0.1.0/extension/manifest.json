{
  "manifest_version": 3,
  "name": "FacadeProxy",
  "version": "0.1.0",
  "description": "Local-first coherent browser persona prototype.",
  "minimum_chrome_version": "115",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "tabs",
    "proxy"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/injected.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "FacadeProxy",
    "default_popup": "popup.html"
  }
}
