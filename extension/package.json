{
  "name": "facadeproxy-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FacadeProxy MV3 browser extension",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:firefox": "vite build && node scripts/build-firefox.mjs",
