    "test:e2e": "playwright test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.14.15",
    "typescript": "^5.5.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
